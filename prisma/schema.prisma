generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tugas {
  id       Int     @id @default(autoincrement())
  judul    String
  matkul   String
  deadline String
  selesai  Boolean @default(false)
}

model Matkul {
  id       Int    @id @default(autoincrement())
  kode     String @unique
  nama     String
  sks      Int
  semester Int
}
